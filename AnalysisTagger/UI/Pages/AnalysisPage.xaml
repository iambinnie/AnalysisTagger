<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AnalysisTagger.UI.Pages.AnalysisPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:dto="clr-namespace:AnalysisTagger.Application.DTOs;assembly=AnalysisTagger.Application"
    xmlns:converters="clr-namespace:AnalysisTagger.UI.Converters"
    xmlns:vm="clr-namespace:AnalysisTagger.UI.ViewModels"
    Title="{Binding ProjectTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Assign Template" Command="{Binding AssignTemplateCommand}" Order="Primary" />
        <ToolbarItem Text="Edit Template"   Command="{Binding EditTemplateCommand}"   Order="Primary" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <toolkit:BoolToObjectConverter x:Key="PlayPauseText" TrueObject="⏸  Pause" FalseObject="▶  Play" />
        <converters:HexColorConverter x:Key="HexColor" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto,Auto,*" RowSpacing="4">

        <!-- Row 0: Video player -->
        <toolkit:MediaElement
            x:Name="VideoElement"
            Grid.Row="0"
            ShouldAutoPlay="False"
            Aspect="AspectFit"
            BackgroundColor="Black" />

        <!-- Row 1: Seek bar -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="80,*,80"
            Margin="12,4"
            ColumnSpacing="8">
            <Label
                Grid.Column="0"
                Text="{Binding PositionText}"
                FontSize="12"
                VerticalOptions="Center"
                HorizontalOptions="End" />
            <Slider
                Grid.Column="1"
                x:Name="SeekSlider"
                Minimum="0"
                Maximum="{Binding DurationSeconds}"
                Value="{Binding PositionSeconds, Mode=OneWay}"
                IsEnabled="{Binding HasMedia}"
                DragStarted="OnSeekDragStarted"
                DragCompleted="OnSeekDragCompleted" />
            <Label
                Grid.Column="2"
                Text="{Binding DurationText}"
                FontSize="12"
                VerticalOptions="Center"
                HorizontalOptions="Start" />
        </Grid>

        <!-- Row 2: Playback controls -->
        <VerticalStackLayout Grid.Row="2" Spacing="6" Margin="12,0,12,4">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Button Text="📂  Load"        Command="{Binding LoadVideoCommand}"      WidthRequest="100" />
                <Button Text="⏮ Frame"        Command="{Binding StepBackwardCommand}"   IsEnabled="{Binding HasMedia}" WidthRequest="90" />
                <Button Text="⏹  Stop"        Command="{Binding StopCommand}"           IsEnabled="{Binding HasMedia}" WidthRequest="90" />
                <Button Text="{Binding IsPlaying, Converter={StaticResource PlayPauseText}}"
                                               Command="{Binding PlayPauseCommand}"      IsEnabled="{Binding HasMedia}" WidthRequest="110" />
                <Button Text="Frame ⏭"        Command="{Binding StepForwardCommand}"    IsEnabled="{Binding HasMedia}" WidthRequest="90" />
            </HorizontalStackLayout>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <Label Text="Speed:" VerticalOptions="Center" />
                <Button Text="0.25×" Command="{Binding SetRateCommand}" CommandParameter="0.25" IsEnabled="{Binding HasMedia}" WidthRequest="65" />
                <Button Text="0.5×"  Command="{Binding SetRateCommand}" CommandParameter="0.5"  IsEnabled="{Binding HasMedia}" WidthRequest="58" />
                <Button Text="1×"    Command="{Binding SetRateCommand}" CommandParameter="1.0"  IsEnabled="{Binding HasMedia}" WidthRequest="48" />
                <Button Text="2×"    Command="{Binding SetRateCommand}" CommandParameter="2.0"  IsEnabled="{Binding HasMedia}" WidthRequest="48" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Row 3: Tagging panel (left) + Event list (right) -->
        <Grid Grid.Row="3" ColumnDefinitions="180,*" ColumnSpacing="0">

            <!-- Category buttons -->
            <Border Grid.Column="0" Stroke="LightGray" StrokeThickness="1" Margin="8,4,4,8">
                <ScrollView>
                    <VerticalStackLayout
                        Padding="8"
                        Spacing="6"
                        BindableLayout.ItemsSource="{Binding CategoryButtons}">
                        <BindableLayout.EmptyView>
                            <Label Text="No categories" TextColor="Gray" FontSize="12" HorizontalOptions="Center" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryButtonViewModel">
                                <Border
                                    BackgroundColor="{Binding Color, Converter={StaticResource HexColor}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6"
                                    Margin="0,0,0,2">
                                    <VerticalStackLayout Spacing="0">

                                        <!-- Main category label — tap tags with no subcategory -->
                                        <Label
                                            Text="{Binding Name}"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HorizontalTextAlignment="Center"
                                            Padding="8,10">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding TagCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>

                                        <!-- Subcategory buttons — 2 per row -->
                                        <VerticalStackLayout
                                            IsVisible="{Binding HasSubCategories}"
                                            Spacing="2"
                                            Padding="4,0,4,4"
                                            BindableLayout.ItemsSource="{Binding SubCategoryRows}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SubCategoryRow">
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                                                        <Button
                                                            Grid.Column="0"
                                                            Text="{Binding Left.Name}"
                                                            Command="{Binding Left.TagCommand}"
                                                            TextColor="White"
                                                            BackgroundColor="#44000000"
                                                            FontSize="11"
                                                            Padding="4,6"
                                                            CornerRadius="4" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Text="{Binding Right.Name}"
                                                            Command="{Binding Right.TagCommand}"
                                                            IsVisible="{Binding HasRight}"
                                                            TextColor="White"
                                                            BackgroundColor="#44000000"
                                                            FontSize="11"
                                                            Padding="4,6"
                                                            CornerRadius="4" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- Event list -->
            <Border Grid.Column="1" Stroke="LightGray" StrokeThickness="1" Margin="4,4,8,8">
                <CollectionView ItemsSource="{Binding Events}">
                    <CollectionView.EmptyView>
                        <Label
                            Text="No tags yet — tap a category button to tag the current moment"
                            TextColor="Gray"
                            FontSize="13"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Margin="16"
                            HorizontalTextAlignment="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:EventTagDto">
                            <Grid ColumnDefinitions="6,*,Auto" Padding="8,6" ColumnSpacing="8">
                                <!-- Category colour bar -->
                                <BoxView
                                    Grid.Column="0"
                                    Color="{Binding CategoryColor, Converter={StaticResource HexColor}}"
                                    CornerRadius="2"
                                    WidthRequest="6" />
                                <!-- Tag info — tap to seek -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SeekToEventCommand}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding CategoryName}" FontAttributes="Bold" FontSize="13" />
                                    <Label
                                        Text="{Binding SubCategory}"
                                        FontSize="12"
                                        TextColor="Gray"
                                        FontAttributes="Italic"
                                        IsVisible="{Binding SubCategory, Converter={toolkit:IsNotNullOrEmptyConverter}}" />
                                    <Label FontSize="12" TextColor="Gray">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding StartTime}" />
                                                <Span Text=" → " />
                                                <Span Text="{Binding EndTime}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label
                                        Text="{Binding Notes}"
                                        FontSize="12"
                                        TextColor="Gray"
                                        IsVisible="{Binding Notes, Converter={toolkit:IsNotNullOrEmptyConverter}}" />
                                </VerticalStackLayout>
                                <!-- Delete button -->
                                <Button
                                    Grid.Column="2"
                                    Text="✕"
                                    FontSize="11"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    TextColor="Gray"
                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteEventCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
