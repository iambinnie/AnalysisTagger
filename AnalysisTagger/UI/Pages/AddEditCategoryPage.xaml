<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AnalysisTagger.UI.Pages.AddEditCategoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Add / Edit Category">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Name" FontSize="12" TextColor="Gray" />
            <Entry Text="{Binding Name}" Placeholder="e.g. Shot on Goal" />

            <Label Text="Colour (hex)" FontSize="12" TextColor="Gray" />
            <Grid ColumnDefinitions="*,36" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding Color}" Placeholder="#3498DB" />
                <BoxView
                    Grid.Column="1"
                    BackgroundColor="{Binding Color}"
                    CornerRadius="4"
                    VerticalOptions="Fill" />
            </Grid>

            <Label Text="Lead time (seconds)" FontSize="12" TextColor="Gray" />
            <Entry
                Text="{Binding LeadTimeText}"
                Keyboard="Numeric"
                Placeholder="2" />

            <Label Text="Lag time (seconds)" FontSize="12" TextColor="Gray" />
            <Entry
                Text="{Binding LagTimeText}"
                Keyboard="Numeric"
                Placeholder="3" />

            <Label Text="Sub-categories (comma-separated, optional)" FontSize="12" TextColor="Gray" />
            <Entry
                Text="{Binding SubCategoriesText}"
                Placeholder="e.g. Left foot, Right foot, Header" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                <Button Grid.Column="0" Text="Cancel" BackgroundColor="Gray" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
