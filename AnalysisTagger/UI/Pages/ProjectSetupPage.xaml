<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AnalysisTagger.UI.Pages.ProjectSetupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:enums="clr-namespace:AnalysisTagger.Domain.Enums;assembly=AnalysisTagger.Domain"
    xmlns:dto="clr-namespace:AnalysisTagger.Application.DTOs;assembly=AnalysisTagger.Application"
    Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- Title -->
            <Label Text="Title" FontAttributes="Bold" />
            <Entry Placeholder="e.g. Arsenal vs Chelsea" Text="{Binding Title}" MaxLength="150" />

            <!-- Competition -->
            <Label Text="Competition" FontAttributes="Bold" Margin="0,8,0,0" />
            <Entry Placeholder="e.g. Premier League" Text="{Binding Competition}" MaxLength="100" />

            <!-- Season -->
            <Label Text="Season" FontAttributes="Bold" Margin="0,8,0,0" />
            <Entry Placeholder="e.g. 2024/25" Text="{Binding Season}" MaxLength="20" />

            <!-- Match Date -->
            <Label Text="Match Date" FontAttributes="Bold" Margin="0,8,0,0" />
            <DatePicker Date="{Binding MatchDate}" Format="d MMM yyyy" />

            <!-- Sport -->
            <Label Text="Sport" FontAttributes="Bold" Margin="0,8,0,0" />
            <Picker
                ItemsSource="{Binding Sports}"
                SelectedItem="{Binding SelectedSport}" />

            <!-- Tagging Mode -->
            <Label Text="Tagging Mode" FontAttributes="Bold" Margin="0,8,0,0" />
            <Picker
                ItemsSource="{Binding TaggingModes}"
                SelectedItem="{Binding SelectedTaggingMode}" />

            <!-- Video File -->
            <Label Text="Video File" FontAttributes="Bold" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry
                    Grid.Column="0"
                    Text="{Binding VideoFilePath}"
                    Placeholder="No video selected"
                    IsReadOnly="True" />
                <Button
                    Grid.Column="1"
                    Text="Browse…"
                    Command="{Binding PickVideoCommand}"
                    WidthRequest="90" />
            </Grid>

            <!-- Teams and Template — create mode only -->
            <VerticalStackLayout
                IsVisible="{Binding IsEditMode, Converter={toolkit:InvertedBoolConverter}}"
                Spacing="16">

                <!-- Home Team -->
                <Label Text="Home Team" FontAttributes="Bold" Margin="0,8,0,0" />
                <Picker
                    ItemsSource="{Binding Teams}"
                    SelectedItem="{Binding SelectedHomeTeam}"
                    ItemDisplayBinding="{Binding Name}" />

                <!-- Away Team -->
                <Label Text="Away Team" FontAttributes="Bold" />
                <Picker
                    ItemsSource="{Binding Teams}"
                    SelectedItem="{Binding SelectedAwayTeam}"
                    ItemDisplayBinding="{Binding Name}" />

                <!-- Template -->
                <Label Text="Template" FontAttributes="Bold" />
                <Picker
                    ItemsSource="{Binding Templates}"
                    SelectedItem="{Binding SelectedTemplate}"
                    ItemDisplayBinding="{Binding Name}" />

            </VerticalStackLayout>

            <!-- Actions -->
            <HorizontalStackLayout HorizontalOptions="End" Spacing="8" Margin="0,16,0,0">
                <Button Text="Cancel" Command="{Binding CancelCommand}" BackgroundColor="Gray" />
                <Button Text="Save" Command="{Binding SaveCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
