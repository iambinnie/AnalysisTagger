<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AnalysisTagger.UI.Pages.TemplateEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:dto="clr-namespace:AnalysisTagger.Application.DTOs;assembly=AnalysisTagger.Application"
    x:Name="ThisPage"
    Title="Edit Template">

    <Grid RowDefinitions="Auto,*">

        <!-- Header editor -->
        <VerticalStackLayout Grid.Row="0" Padding="16" Spacing="8">
            <Label Text="Name" FontSize="12" TextColor="Gray" />
            <Entry
                Text="{Binding TemplateName}"
                Placeholder="Template name"
                IsEnabled="{Binding IsBuiltIn, Converter={toolkit:InvertedBoolConverter}}" />

            <Label Text="Sport" FontSize="12" TextColor="Gray" />
            <Picker
                ItemsSource="{Binding SportTypes}"
                SelectedItem="{Binding SelectedSport}"
                IsEnabled="{Binding IsBuiltIn, Converter={toolkit:InvertedBoolConverter}}" />

            <Button
                Text="Save"
                HorizontalOptions="End"
                Command="{Binding SaveTemplateCommand}"
                IsEnabled="{Binding IsBuiltIn, Converter={toolkit:InvertedBoolConverter}}" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,4" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Categories" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="+ Add Category" Command="{Binding AddCategoryCommand}" />
            </Grid>
        </VerticalStackLayout>

        <!-- Categories list -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Categories}">
            <CollectionView.EmptyView>
                <Label
                    Text="No categories yet — tap '+ Add Category'"
                    TextColor="Gray"
                    FontSize="13"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Margin="16" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:CategoryEditorDto">
                    <Grid ColumnDefinitions="8,*,Auto,Auto" Padding="12,8" ColumnSpacing="10">

                        <!-- Color swatch -->
                        <BoxView
                            Grid.Column="0"
                            WidthRequest="8"
                            CornerRadius="4"
                            BackgroundColor="{Binding Color}"
                            VerticalOptions="Fill" />

                        <!-- Info -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" />
                            <Label FontSize="11" TextColor="Gray">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Lead " />
                                        <Span Text="{Binding LeadTimeSeconds}" />
                                        <Span Text="s · Lag " />
                                        <Span Text="{Binding LagTimeSeconds}" />
                                        <Span Text="s" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <!-- Edit -->
                        <Button
                            Grid.Column="2"
                            Text="✏️"
                            FontSize="13"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            BackgroundColor="Transparent"
                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditCategoryCommand}"
                            CommandParameter="{Binding .}" />

                        <!-- Delete -->
                        <Button
                            Grid.Column="3"
                            Text="🗑"
                            FontSize="13"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            BackgroundColor="Transparent"
                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteCategoryCommand}"
                            CommandParameter="{Binding .}" />

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
